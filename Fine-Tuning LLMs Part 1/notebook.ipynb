   "outputs": [],
   "source": [
    "LABELS = [\n",
    "    \"card_arrival\", \"card_not_working\", \"card_swallowed\", \"card_about_to_expire\",\n",
    "    \"card_linking\", \"activate_my_card\", \"lost_or_stolen_card\", \"declined_card_payment\",\n",
    "    \"card_payment_not_recognised\", \"compromised_card\",\n",
    "]\n",
    "\n",
    "TRAIN_URL = \"https://raw.githubusercontent.com/PolyAI-LDN/task-specific-datasets/master/banking_data/train.csv\"\n",
    "TEST_URL = \"https://raw.githubusercontent.com/PolyAI-LDN/task-specific-datasets/master/banking_data/test.csv\"\n",
    "\n",
    "full_train = pd.read_csv(TRAIN_URL).rename(columns={\"category\": \"label\"})\n",
    "full_test = pd.read_csv(TEST_URL).rename(columns={\"category\": \"label\"})\n",
    "\n",
    "full_train = full_train[full_train[\"label\"].isin(LABELS)][[\"text\", \"label\"]]\n",
    "full_test = full_test[full_test[\"label\"].isin(LABELS)][[\"text\", \"label\"]]\n",
    "\n",
    "sampled = []\n",
    "for lbl in LABELS:\n",
    "    group = full_train[full_train[\"label\"] == lbl]\n",
    "    sampled.append(group.sample(min(len(group), 30), random_state=SEED))\n",
    "\n",
    "train_df = pd.concat(sampled).sample(frac=1, random_state=SEED).reset_index(drop=True)\n",
    "test_df = full_test.sample(n=50, random_state=SEED).reset_index(drop=True)\n",
    "\n",
    "print(f\"Train set: {len(train_df)} examples\")\n",
    "print(f\"Test set:  {len(test_df)} examples\")\n",
    "train_df.head()\n"
   ]
